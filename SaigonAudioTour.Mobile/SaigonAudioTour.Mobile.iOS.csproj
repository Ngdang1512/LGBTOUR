<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-ios</TargetFramework>

		<OutputType>Exe</OutputType>
		<RootNamespace>SaigonAudioTour.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<ApplicationTitle>Saigon Audio Tour</ApplicationTitle>
		<ApplicationId>com.companyname.saigonaudiotour.mobile</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0F172A" />
		<MauiSplashScreen Include="Resources\AppIcon\appicon.svg" Color="#0F172A" BaseSize="128,128" />
		<MauiImage Include="Resources\Image\*" />
		<MauiImage Remove="Resources\Image\DS_Store" />
		<MauiImage Remove="Resources\Image\.DS_Store" />
		<MauiImage Update="Resources\Image\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls.Maps" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Platforms\Android\**\*.cs" />
		<Compile Remove="Platforms\MacCatalyst\**\*.cs" />
		<Compile Remove="Platforms\Windows\**\*.cs" />
		<None Remove="Platforms\Android\**\*" />
		<None Remove="Platforms\MacCatalyst\**\*" />
		<None Remove="Platforms\Windows\**\*" />
		<MauiXaml Remove="Platforms\Android\**\*.xaml" />
		<MauiXaml Remove="Platforms\MacCatalyst\**\*.xaml" />
		<MauiXaml Remove="Platforms\Windows\**\*.xaml" />
	</ItemGroup>

</Project>
