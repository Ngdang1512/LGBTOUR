<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             xmlns:local="clr-namespace:SaigonAudioTour.Mobile"
             x:Class="SaigonAudioTour.Mobile.MapPage"
             x:DataType="local:MapPage"
             BackgroundColor="{StaticResource BgColor}"
             Shell.NavBarIsVisible="False">

       <Grid RowDefinitions="Auto, *">
        
        <!-- Header with GPS Status -->
        <Border Grid.Row="0" Margin="12, 12, 12, 0" Padding="16" 
               BackgroundColor="{StaticResource SurfaceColor}"
               Stroke="{StaticResource BorderColor}" StrokeThickness="1"
               StrokeShape="RoundRectangle 12">
            <Border.Shadow>
                <Shadow Brush="#94A3B8" Offset="0,2" Radius="8" Opacity="0.08" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                
                <!-- Location Icon -->
                <Label Grid.Column="0" Text="📍" FontSize="24" VerticalOptions="Center" />
                
                <!-- Text Info -->
                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                    <Label Text="Tuyến bus 2 tầng Quận 1" FontSize="14" FontAttributes="Bold"
                           TextColor="{StaticResource TextColor}" />
                    <Label x:Name="GpsStatusLabel" Text="Đang tìm GPS..." FontSize="12"
                           TextColor="{StaticResource TextSecondary}" />
                    <Label Text="{Binding ActiveGeofenceLabelText}"
                           IsVisible="{Binding IsActiveGeofenceVisible}"
                           FontSize="11"
                           FontAttributes="Bold"
                           TextColor="#7C3AED" />
                    <Label Text="Vòng geofence: xanh = xa, vàng = gần, đỏ = kích hoạt" FontSize="11"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                
                <!-- GPS Indicator -->
                <Border Grid.Column="2" WidthRequest="12" HeightRequest="12"
                       BackgroundColor="{StaticResource GeofenceInactive}"
                       StrokeShape="RoundRectangle 6"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

        <!-- Map Container -->
       <Border Grid.Row="1" Margin="12, 12, 12, 12" 
               BackgroundColor="{StaticResource SurfaceColor}"
               Stroke="{StaticResource BorderColor}" StrokeThickness="1"
               StrokeShape="RoundRectangle 16">
            <Border.Shadow>
                <Shadow Brush="#64748B" Offset="0,4" Radius="12" Opacity="0.1" />
            </Border.Shadow>

                     <Grid>
                            <maps:Map x:Name="MyMap"
                                            IsShowingUser="False"
                                            MapType="Street">
                                   <maps:Map.Triggers>
                                          <DataTrigger TargetType="maps:Map" Binding="{Binding IsFallbackMode}" Value="True">
                                                 <Setter Property="IsVisible" Value="False" />
                                          </DataTrigger>
                                   </maps:Map.Triggers>
                            </maps:Map>

                            <Border IsVisible="{Binding IsFallbackMode}"
                                          Margin="12"
                                          Padding="14"
                                          BackgroundColor="#FFF7ED"
                                          Stroke="#FB923C"
                                          StrokeThickness="1"
                                          VerticalOptions="Fill"
                                          HorizontalOptions="Fill">
                                   <Border.StrokeShape>
                                          <RoundRectangle CornerRadius="12" />
                                   </Border.StrokeShape>
                                   <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                                          <Label Text="Chế độ bản đồ tương thích" FontAttributes="Bold" TextColor="#9A3412" />
                                          <Label Grid.Row="1" Text="Đang dùng OpenStreetMap để đảm bảo hiển thị ổn định trên thiết bị hiện tại." FontSize="12" TextColor="#7C2D12" />

                                          <WebView x:Name="OsmWebView"
                                                   Grid.Row="2"
                                                   VerticalOptions="FillAndExpand"
                                                   BackgroundColor="White" />

                                          <Button Text="Mở tuyến điểm bằng Google Maps"
                                                        Grid.Row="3"
                                                        Clicked="OnOpenExternalMapClicked"
                                                        BackgroundColor="{StaticResource Primary}"
                                                        TextColor="White"
                                                        CornerRadius="10" />
                                   </Grid>
                            </Border>
                     </Grid>
        </Border>

        <!-- Geofence Alert Popup (Bottom Sheet) -->
        <Border Grid.Row="1" Margin="12, 0, 12, 12" Padding="0"
               BackgroundColor="{StaticResource SurfaceColor}"
               Stroke="{StaticResource Primary}" StrokeThickness="2"
               StrokeShape="RoundRectangle 16"
               IsVisible="False"
               x:Name="NarrationFrame">
            
            <VerticalStackLayout Padding="20" Spacing="12">
                
                <!-- Close Button (Top Right) -->
                <Button Text="✕" 
                       BackgroundColor="Transparent"
                       TextColor="{StaticResource TextSecondary}"
                       Padding="0" Margin="0, -10, -10, 0"
                       HorizontalOptions="End"
                       FontSize="20"
                       x:Name="CloseNarrationBtn" />
                
                <!-- POI Info -->
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="PoiNameLabel" Text="Tên quán" 
                           FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource TextColor}" />
                    <Label x:Name="PoiCategoryLabel" Text="Danh mục"
                           FontSize="12" TextColor="{StaticResource TextSecondary}" />
                    <Label x:Name="PoiDistanceLabel" Text="Khoảng cách"
                           FontSize="12" TextColor="{StaticResource Accent}" />
                </VerticalStackLayout>

                <!-- Image (if available) -->
                  <Image x:Name="PoiImage" Aspect="AspectFill" 
                         HeightRequest="120" />

                <!-- Description -->
                <Label x:Name="PoiDescriptionLabel" Text="Mô tả quán"
                       FontSize="13" TextColor="{StaticResource TextColor}"
                       LineBreakMode="WordWrap" />

                <!-- Audio Playback Controls -->
                <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Margin="0, 8">
                    <Button Grid.Column="0" Text="▶️" 
                           BackgroundColor="{StaticResource Accent}"
                           TextColor="White" FontAttributes="Bold"
                           Padding="12, 10" CornerRadius="24"
                           WidthRequest="48" HeightRequest="48"
                           FontSize="16"
                           x:Name="PlayAudioBtn" />
                    
                    <ProgressBar Grid.Column="1" 
                                VerticalOptions="Center"
                                Progress="0"
                                ProgressColor="{StaticResource Primary}"
                                x:Name="AudioProgressBar" />
                    
                    <Label Grid.Column="2" Text="0:00" FontSize="12"
                          TextColor="{StaticResource TextSecondary}"
                          VerticalOptions="Center" />
                </Grid>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0, 8">
                    <Button Grid.Column="0" Text="Xem Chi Tiết"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource Accent}"
                           BorderColor="{StaticResource Accent}"
                           BorderWidth="1"
                           CornerRadius="8"
                           Padding="0, 12"
                           FontSize="13" />
                    
                    <Button Grid.Column="1" Text="Gọi Quán"
                           BackgroundColor="{StaticResource Primary}"
                           TextColor="White"
                           CornerRadius="8"
                           Padding="0, 12"
                           FontSize="13" />
                </Grid>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>