<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <!-- Primary Colors (SAT Premium Navy + Gold) -->
    <Color x:Key="Primary">#0F172A</Color>
    <Color x:Key="PrimaryLight">#F5B841</Color>
    <Color x:Key="PrimaryDark">#08111F</Color>

    <!-- Accent Colors -->
    <Color x:Key="Accent">#F97316</Color>
    <Color x:Key="AccentLight">#FDBA74</Color>
    
    <!-- Background & Surface -->
    <Color x:Key="BgColor">#F6F8FB</Color>
    <Color x:Key="SurfaceColor">#ffffff</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextColor">#111827</Color>
    <Color x:Key="TextSecondary">#4B5563</Color>
    <Color x:Key="TextLight">#94A3B8</Color>
    
    <!-- Border & Divider -->
    <Color x:Key="BorderColor">#E5E7EB</Color>
    <Color x:Key="DividerColor">#E5E7EB</Color>
    
    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#2e7d32</Color>
    <Color x:Key="WarningColor">#f57f17</Color>
    <Color x:Key="InfoColor">#1565c0</Color>
    <Color x:Key="ErrorColor">#c62828</Color>
    
    <!-- Geofence/Location -->
    <Color x:Key="LocationDot">#2563EB</Color>
    <Color x:Key="GeofenceActive">#22C55E</Color>
    <Color x:Key="GeofenceInactive">#94A3B8</Color>
    
</ResourceDictionary>
