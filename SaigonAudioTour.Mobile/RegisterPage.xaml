<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SaigonAudioTour.Mobile.RegisterPage"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">

    <Grid Padding="30" VerticalOptions="Center">
        <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="30">
            <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#64748B" Offset="0,15" Radius="30" Opacity="0.1" /></Border.Shadow>
            
            <VerticalStackLayout Spacing="25">
                
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="Tạo tài khoản" FontSize="30" FontAttributes="Bold" TextColor="#0F172A" HorizontalOptions="Center"/>
                    <Label Text="Cùng SaigonAudioTour khám phá thế giới" FontSize="14" TextColor="#64748B" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="15">
                    <Border Stroke="#E2E8F0" StrokeThickness="1" Padding="20, 5" BackgroundColor="White">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Entry x:Name="FullNameEntry" Placeholder="Họ và tên" PlaceholderColor="#CBD5E1" TextColor="#0F172A" /> 
                    </Border>

                    <Border Stroke="#E2E8F0" StrokeThickness="1" Padding="20, 5" BackgroundColor="White">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Entry x:Name="EmailEntry" Placeholder="Email của bạn" PlaceholderColor="#CBD5E1" TextColor="#0F172A" Keyboard="Email" /> 
                    </Border>

                    <Border Stroke="#E2E8F0" StrokeThickness="1" Padding="20, 5" BackgroundColor="White">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Entry x:Name="PasswordEntry" Placeholder="Mật khẩu" PlaceholderColor="#CBD5E1" TextColor="#0F172A" IsPassword="True" /> 
                    </Border>
                    
                    <Border Stroke="#E2E8F0" StrokeThickness="1" Padding="20, 5" BackgroundColor="White">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <Entry x:Name="ConfirmPasswordEntry" Placeholder="Xác nhận mật khẩu" PlaceholderColor="#CBD5E1" TextColor="#0F172A" IsPassword="True" /> 
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="15" Margin="0, 10, 0, 0">
                    <Button Text="Tạo tài khoản ngay" BackgroundColor="#0F172A" TextColor="White" FontSize="16" FontAttributes="Bold" CornerRadius="12" HeightRequest="55" Clicked="OnRegisterClicked" />
                    
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="Đã có tài khoản?" TextColor="#64748B" FontSize="14"/>
                        <Label Text="Đăng nhập ngay" TextColor="#0F172A" FontSize="14" FontAttributes="Bold">
                            <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnLoginLabelTapped"/></Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>