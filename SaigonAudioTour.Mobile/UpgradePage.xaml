<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:SaigonAudioTour.Mobile"
             xmlns:models="clr-namespace:SaigonAudioTour.Mobile.Models"
             x:Class="SaigonAudioTour.Mobile.UpgradePage"
             x:DataType="local:UpgradePage"
             Title="Nâng cấp Premium"
             BackgroundColor="#F8FAFC">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Label Text="Nâng cấp tài khoản" FontSize="24" FontAttributes="Bold" TextColor="#0F172A" />
            <Label Text="Mở toàn bộ tính năng cao cấp bằng thanh toán QR hoặc ngoài app." TextColor="#64748B" />

            <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="{Binding PremiumStatusText}" FontAttributes="Bold" TextColor="#0F172A" />
            </Border>

            <Label Text="Chọn gói" FontAttributes="Bold" TextColor="#0F172A" />

            <CollectionView ItemsSource="{Binding Plans}" SelectionMode="Single" SelectionChanged="OnPlanSelected">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PremiumPlan">
                        <Border BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#0F172A" />
                                <Label Text="{Binding Price, StringFormat='{}{0:N0} đ'}" TextColor="#EA580C" FontAttributes="Bold" />
                                <Label Text="{Binding Features}" FontSize="12" TextColor="#64748B" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Tạo mã QR thanh toán" Clicked="OnCreateOrderClicked"
                    BackgroundColor="#F97316" TextColor="White" CornerRadius="10" HeightRequest="48" />

            <Border IsVisible="{Binding IsOrderVisible}" BackgroundColor="White" Stroke="#E2E8F0" StrokeThickness="1" Padding="12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding OrderInfoText}" TextColor="#334155" FontSize="12" />
                    <Image Source="{Binding CurrentOrder.QrImageUrl}" HeightRequest="260" Aspect="AspectFit" />
                    <Button Text="Tôi đã thanh toán (demo)" Clicked="OnMarkPaidClicked"
                            BackgroundColor="#16A34A" TextColor="White" CornerRadius="10" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Link tải app demo" FontAttributes="Bold" TextColor="#0F172A" Margin="0,10,0,0" />
            <Label Text="Android: https://appdistribution.firebase.google.com/..." FontSize="12" TextColor="#2563EB" />
            <Label Text="iOS: https://testflight.apple.com/join/..." FontSize="12" TextColor="#2563EB" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
