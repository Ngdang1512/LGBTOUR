# ─────────────────────────────────────────────
#  SaigonAudioTour — Environment Variables
#  Copy file này thành .env rồi điền giá trị
#  cp .env.example .env
# ─────────────────────────────────────────────

# Database
DB_PASSWORD=SaigonTour@2026

# JWT (bắt buộc đổi trong production — min 32 ký tự)
JWT_SECRET=saigontour-dev-secret-change-in-production-min-32-chars

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# VNPay (lấy từ https://sandbox.vnpayment.vn/devreg)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/result

# CORS — cho phép React dev servers
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
