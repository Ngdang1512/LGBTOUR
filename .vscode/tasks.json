{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Android Lite",
			"type": "shell",
			"command": "dotnet",
			"args": [
				"build",
				"-t:Run",
				"-p:Configuration=Debug",
				"-f",
				"net10.0-android",
				"-p:AdbTarget=-s emulator-5554",
				"-p:AndroidAttachDebugger=false",
				"-p:EnableDiagnostics=false",
				"-p:EnableMauiXamlDiagnostics=false",
				"/Users/admin/Code/SaigonAudioTour/SaigonAudioTour.Mobile/SaigonAudioTour.Mobile.csproj"
			],
			"isBackground": false
		},
		{
			"label": "Reinstall Android App",
			"type": "shell",
			"command": "bash",
			"args": ["/Users/admin/Code/SaigonAudioTour/scripts/reinstall_android.sh"],
			"isBackground": false
		}
	]
}