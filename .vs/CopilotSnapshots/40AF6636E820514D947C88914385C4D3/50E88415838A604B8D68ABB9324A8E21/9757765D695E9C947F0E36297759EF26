using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

using System;

namespace LGBTOUR.Api.Entities
{
    public class UserLog
    {
        [Key]
        public int Id { get; set; }

        [Required]
        [MaxLength(100)]
        public string DeviceId { get; set; } // ID ẩn danh của điện thoại (không lưu info cá nhân để bảo mật)

        public int POI_Id { get; set; }
        [ForeignKey("POI_Id")]
        public POI POI { get; set; }

        public DateTime TriggerTime { get; set; } = DateTime.UtcNow; // Thời điểm người dùng đi vào bán kính Geofence

        public bool IsAudioPlayed { get; set; } // App đã phát âm thanh thành công hay chưa?
    }
}