                  "VoiceType": {
                    "type": "string"
                  },
                  "AudioFile": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "PoiId": {
                  "style": "form"
                },
                "LanguageCode": {
