  "components": {
    "schemas": {
      "AddPoiToTourDto": {
        "required": [
          "displayOrder",
          "poiId"
        ],
        "type": "object",
        "properties": {
          "poiId": {
            "type": "integer",
            "format": "int32"
          },
          "displayOrder": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreatePoiDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "radius": {
            "type": "integer",
            "format": "int32"
          },
          "priority": {
            "type": "integer",
            "format": "int32"
          },
          "isStopStation": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreateTourDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "estimatedTimeMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "ticketPrice": {
            "type": "number",
            "format": "double"
          },
          "totalDistanceKm": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "password",
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PoiDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "lat": {
            "type": "number",
            "format": "double"
          },
          "lng": {
            "type": "number",
            "format": "double"
          },
          "priority": {
            "type": "integer",
            "format": "int32"
          },
          "radius": {
            "type": "integer",
            "format": "int32"
          },
          "isStopStation": {
            "type": "boolean"
          },
          "narrationCount": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PoiStatisticDto": {
        "type": "object",
        "properties": {
          "poiId": {
            "type": "integer",
            "format": "int32"
          },
          "poiName": {
            "type": "string",
            "nullable": true
          },
          "totalListens": {
            "type": "integer",
            "format": "int32"
