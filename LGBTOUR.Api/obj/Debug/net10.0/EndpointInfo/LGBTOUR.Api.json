          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "estimatedTimeMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "ticketPrice": {
            "type": "number",
            "format": "double"
          },
          "totalDistanceKm": {
            "type": "number",
            "format": "double"
          },
