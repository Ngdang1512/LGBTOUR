<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LGBTOUR.Mobile.RegisterPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="30, 60, 30, 40" Spacing="20">
            
            <Label Text="Tạo tài khoản" FontSize="30" FontAttributes="Bold" TextColor="#111827" Margin="0,0,0,20"/>

            <VerticalStackLayout Spacing="15">
                <Label Text="Họ và tên" TextColor="#374151" FontAttributes="Bold" FontSize="14"/>
                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" Padding="15,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Placeholder="Nguyễn Văn A" TextColor="#111827" BackgroundColor="Transparent"/>
                </Border>

                <Label Text="Email" TextColor="#374151" FontAttributes="Bold" FontSize="14"/>
                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" Padding="15,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Placeholder="nhap@email.com" Keyboard="Email" TextColor="#111827" BackgroundColor="Transparent"/>
                </Border>

                <Label Text="Mật khẩu" TextColor="#374151" FontAttributes="Bold" FontSize="14"/>
                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" Padding="15,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Placeholder="••••••••" IsPassword="True" TextColor="#111827" BackgroundColor="Transparent"/>
                </Border>

                <Button Text="ĐĂNG KÝ" BackgroundColor="#4F46E5" TextColor="White" FontAttributes="Bold" 
                        CornerRadius="14" HeightRequest="55" Margin="0,20,0,0" Clicked="OnRegisterClicked"/>
            </VerticalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,20,0,0">
                <Label Text="Đã có tài khoản?" TextColor="#6B7280" VerticalOptions="Center"/>
                <Label Text="Đăng nhập" TextColor="#4F46E5" FontAttributes="Bold" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>