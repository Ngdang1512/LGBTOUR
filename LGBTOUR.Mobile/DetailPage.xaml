<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LGBTOUR.Mobile"
             x:Class="LGBTOUR.Mobile.DetailPage"
             Title="Chi Tiết Quán Ăn"
             BackgroundColor="{StaticResource BgColor}"
             Shell.NavBarIsVisible="True"
             Shell.NavBarHasShadow="False">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            
            <!-- Hero Image -->
            <Image Source="{Binding SelectedPlace.ImageUrl}" 
                   Aspect="AspectFill"
                   HeightRequest="300"
                   HorizontalOptions="Fill" />

            <VerticalStackLayout Padding="20, 20" Spacing="20">
                
                <!-- Category & Rating Badge -->
                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                    <Border Padding="10, 6" BackgroundColor="{StaticResource Primary}" 
                           Stroke="Transparent" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="6"/></Border.StrokeShape>
                        <Label Text="{Binding SelectedPlace.Category}" FontSize="12" 
                               TextColor="White" FontAttributes="Bold"/>
                    </Border>
                    
                    <HorizontalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="End">
                        <Label Text="⭐" FontSize="16" VerticalOptions="Center" />
                        <Label Text="{Binding SelectedPlace.Rating}" FontSize="14" 
                               TextColor="{StaticResource TextColor}" FontAttributes="Bold" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Title & Location -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding SelectedPlace.Name}" FontSize="28" FontAttributes="Bold" 
                           TextColor="{StaticResource TextColor}" LineHeight="1.2" />
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="📍" FontSize="14" />
                        <Label Text="{Binding SelectedPlace.Location}" FontSize="14" 
                               TextColor="{StaticResource TextSecondary}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Audio Narration Section -->
                <Border BackgroundColor="#F0F9FF" Stroke="{StaticResource InfoColor}" 
                       StrokeThickness="1" Padding="16" Margin="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🎧 Hướng Dẫn Âm Thanh" FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource InfoColor}" />
                        
                        <Picker x:Name="LanguagePicker" 
                               Title="Chọn ngôn ngữ" 
                               TextColor="{StaticResource TextColor}"
                               FontSize="13"
                               BackgroundColor="Transparent" 
                               Margin="0" Padding="0" />

                        <!-- Audio Controls -->
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8" Margin="0, 8">
                            <Button Grid.Column="0" Text="▶️ Phát" 
                                   BackgroundColor="{StaticResource SuccessColor}"
                                   TextColor="White" FontSize="12" FontAttributes="Bold"
                                   Padding="12, 10" CornerRadius="8"
                                   WidthRequest="60" HeightRequest="44"
                                   x:Name="PlayButton" Clicked="OnPlayClicked" />
                            
                            <ProgressBar Grid.Column="1" 
                                        VerticalOptions="Center"
                                        Progress="0"
                                        ProgressColor="{StaticResource Primary}"
                                        x:Name="AudioProgressBar" Margin="0, 0, 0, 0" />
                            
                            <Button Grid.Column="2" Text="⏹️ Dừng"
                                   BackgroundColor="{StaticResource ErrorColor}"
                                   TextColor="White" FontSize="12" FontAttributes="Bold"
                                   Padding="12, 10" CornerRadius="8"
                                   WidthRequest="60" HeightRequest="44"
                                   x:Name="StopButton" Clicked="OnStopClicked" 
                                   IsVisible="False" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Description -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Giới Thiệu" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextColor}" />
                    <Label Text="{Binding SelectedPlace.TtsScript}" FontSize="14"
                           TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <!-- Geofence Info -->
                <Border BackgroundColor="#FEF3C7" Stroke="#F59E0B" 
                       StrokeThickness="1" Padding="14" Margin="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="📡 Kích Hoạt Tự Động" FontSize="13" FontAttributes="Bold"
                               TextColor="#92400E" />
                        <Label Text="{Binding SelectedPlace.TriggerRadius, StringFormat='Cách khoảng {0}m tự động phát hướng dẫn'}" 
                               FontSize="12" TextColor="#B45309" />
                    </VerticalStackLayout>
                </Border>

                <!-- Action Buttons -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0, 12">
                    <Button Grid.Column="0" Text="📞 Gọi Quán"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource Primary}"
                           BorderColor="{StaticResource Primary}"
                           BorderWidth="2"
                           CornerRadius="10"
                           Padding="0, 14"
                           FontSize="14" FontAttributes="Bold"
                           Clicked="OnCallClicked" />
                    
                    <Button Grid.Column="1" Text="🗺️ Chỉ Đường"
                           BackgroundColor="{StaticResource Primary}"
                           TextColor="White"
                           CornerRadius="10"
                           Padding="0, 14"
                           FontSize="14" FontAttributes="Bold"
                           Clicked="OnNavigateClicked" />
                </Grid>

                <!-- Share & Favorite -->
                <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                    <Button Grid.Column="0" Text="❤️ Yêu Thích"
                           BackgroundColor="{StaticResource SurfaceColor}"
                           TextColor="{StaticResource ErrorColor}"
                           BorderColor="{StaticResource BorderColor}"
                           BorderWidth="1"
                           CornerRadius="10"
                           Padding="0, 14"
                           FontSize="14" FontAttributes="Bold" />
                    
                    <Button Grid.Column="1" Text="📤 Chia Sẻ"
                           BackgroundColor="{StaticResource SurfaceColor}"
                           TextColor="{StaticResource TextColor}"
                           BorderColor="{StaticResource BorderColor}"
                           BorderWidth="1"
                           CornerRadius="10"
                           Padding="0, 14"
                           FontSize="14" FontAttributes="Bold"
                           Clicked="OnShareClicked" />
                </Grid>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>