<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LGBTOUR.Mobile.DetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="White">

    <ScrollView VerticalScrollBarVisibility="Never">
        <Grid RowDefinitions="350, Auto">
            
            <Image Source="{Binding SelectedPlace.ImageUrl}" Aspect="AspectFill" Grid.Row="0" />

            <Border Grid.Row="0" Margin="20,50,0,0" WidthRequest="44" HeightRequest="44" 
                    HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="#80000000" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnBackTapped"/></Border.GestureRecognizers>
                <Label Text="←" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="White"/>
            </Border>

            <Border Grid.Row="1" BackgroundColor="White" Margin="0,-40,0,0" Padding="25" StrokeThickness="0">
                <Border.StrokeShape><RoundRectangle CornerRadius="40,40,0,0"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="15">
                    
                    <Label Text="{Binding SelectedPlace.Name}" FontSize="28" FontAttributes="Bold" TextColor="#111827"/>
                    
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="📍" FontSize="16" VerticalOptions="Center"/>
                        <Label Text="{Binding SelectedPlace.Location}" FontSize="15" TextColor="#6B7280" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Button x:Name="PlayButton" Text="▶️ NGHE THUYẾT MINH" BackgroundColor="#4F46E5" TextColor="White" 
                            FontAttributes="Bold" CornerRadius="14" HeightRequest="55" Margin="0,15,0,15"
                            Clicked="OnPlayAudioClicked" />

                    <Label Text="Nội dung thuyết minh:" FontSize="18" FontAttributes="Bold" TextColor="#111827"/>
                    <Label Text="{Binding SelectedPlace.TtsScript}" FontSize="16" LineHeight="1.6" TextColor="#4B5563"/>
                    
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>