<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LGBTOUR.Mobile.DetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="True"
             Shell.PresentationMode="ModalAnimated"
             BackgroundColor="White">

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0" ShowsVerticalScrollIndicator="False">
            <VerticalStackLayout Spacing="0">
                
                <Grid HeightRequest="400">
                    <Image Source="https://images.unsplash.com/photo-1555921015-5532091f6026?auto=format&amp;fit=crop&amp;w=800&amp;q=80" 
                           Aspect="AspectFill" />
                    
                    <BoxView HeightRequest="150" VerticalOptions="Start">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#80000000" Offset="0.0" />
                                <GradientStop Color="Transparent" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <Border Margin="20,50,0,0" WidthRequest="44" HeightRequest="44" 
                            HorizontalOptions="Start" VerticalOptions="Start"
                            BackgroundColor="#CCFFFFFF" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                        <Label Text="✕" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackButtonClicked" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <VerticalStackLayout Padding="24" Spacing="20" Margin="0,-30,0,0" BackgroundColor="White">
                    <Border.StrokeShape><RoundRectangle CornerRadius="30,30,0,0"/></Border.StrokeShape>
                    
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="5">
                            <Border BackgroundColor="#EEF2FF" Padding="8,4" StrokeThickness="0">
                                <Border.StrokeShape><RoundRectangle CornerRectangle="8"/></Border.StrokeShape>
                                <Label Text="DI SẢN" TextColor="#4F46E5" FontSize="10" FontAttributes="Bold"/>
                            </Border>
                            <Label Text="•" TextColor="#D1D5DB" VerticalOptions="Center"/>
                            <Label Text="Hà Nội, Việt Nam" TextColor="#6B7280" FontSize="13" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        
                        <Label Text="Chợ đêm Phố Cổ" FontSize="28" FontAttributes="Bold" TextColor="#111827"/>
                        
                        <Grid ColumnDefinitions="Auto, *">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="⭐️" FontSize="14" VerticalOptions="Center"/>
                                <Label Text="4.8" FontAttributes="Bold" FontSize="15" VerticalOptions="Center"/>
                                <Label Text="(1,250 đánh giá)" TextColor="#9CA3AF" FontSize="14" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F3F4F6" />

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Giới thiệu" FontSize="18" FontAttributes="Bold" TextColor="#111827"/>
                        <Label Text="Nằm ngay tại trung tâm quận Hoàn Kiếm, chợ đêm Phố Cổ là điểm đến không thể bỏ qua cho du khách muốn trải nghiệm nhịp sống sôi động của Hà Nội về đêm. Tại đây, bạn sẽ được thưởng thức những món ăn đường phố trứ danh như bún chả, nem lụi và mua sắm những món quà lưu niệm tinh xảo." 
                               TextColor="#4B5563" FontSize="16" LineHeight="1.6" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*, *, *" Margin="0,10">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="5">
                            <Label Text="🕒" FontSize="24" HorizontalOptions="Center"/>
                            <Label Text="18:00 - 23:00" FontSize="12" TextColor="#6B7280" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="5">
                            <Label Text="🎟️" FontSize="24" HorizontalOptions="Center"/>
                            <Label Text="Miễn phí" FontSize="12" TextColor="#6B7280" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="5">
                            <Label Text="🚶" FontSize="24" HorizontalOptions="Center"/>
                            <Label Text="Phố đi bộ" FontSize="12" TextColor="#6B7280" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                    
                    <BoxView HeightRequest="80" Color="Transparent"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="White" Padding="20,15,20,35" StrokeThickness="1" Stroke="#F3F4F6">
            <Border.StrokeShape><RoundRectangle CornerRadius="20,20,0,0"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="Black" Offset="0,-5" Radius="15" Opacity="0.05"/></Border.Shadow>
            <Grid ColumnDefinitions="Auto, *">
                <VerticalStackLayout VerticalOptions="Center" Margin="0,0,30,0">
                    <Label Text="Giá tham khảo" FontSize="12" TextColor="#9CA3AF"/>
                    <Label Text="Miễn phí" FontSize="20" FontAttributes="Bold" TextColor="#4F46E5"/>
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Lên lịch trình ngay" 
                        BackgroundColor="#4F46E5" TextColor="White" 
                        FontAttributes="Bold" CornerRadius="16" HeightRequest="56">
                    <Button.Shadow>
                        <Shadow Brush="#4F46E5" Offset="0,4" Radius="10" Opacity="0.3"/>
                    </Button.Shadow>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ContentPage>