<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LGBTOUR.Mobile.MainPage"
             BackgroundColor="#F4F6F8"
             Shell.NavBarIsVisible="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="20, 50, 20, 40" Spacing="30">
            
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout VerticalOptions="Center">
                    <Label Text="Chào buổi sáng," TextColor="#8A92A6" FontSize="14" />
                    <Label Text="Du khách VIP" TextColor="#111827" FontSize="26" FontAttributes="Bold" />
                </VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="55" HeightRequest="55" StrokeShape="RoundRectangle 27.5" StrokeThickness="0">
                    <Image Source="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=200" Aspect="AspectFill" />
                </Border>
            </Grid>

            <Border Stroke="Transparent" BackgroundColor="White" Padding="15, 2">
                <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                <Border.Shadow><Shadow Brush="#9CA3AF" Offset="0, 8" Radius="15" Opacity="0.1" /></Border.Shadow>
                <Grid ColumnDefinitions="Auto, *">
                    <Label Text="🔍" VerticalOptions="Center" FontSize="18" Margin="0,0,10,0" />
                    
                    <Entry Grid.Column="1" 
                           Placeholder="Tìm kiếm điểm đến..." 
                           PlaceholderColor="#9CA3AF" 
                           TextColor="#111827" 
                           BackgroundColor="Transparent"
                           TextChanged="OnSearchTextChanged" /> 
                </Grid>
            </Border>

            <VerticalStackLayout Spacing="15">
                <Label Text="Danh mục" FontSize="20" FontAttributes="Bold" TextColor="#111827" />
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="12">
                        
                        <Border Padding="18,12" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Popular"/></Border.GestureRecognizers>
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedCategory}" Value="Popular"><Setter Property="BackgroundColor" Value="#4F46E5" /><Setter Property="Stroke" Value="Transparent" /></DataTrigger>
                            </Border.Triggers>
                            <Label Text="Phổ biến" TextColor="#4B5563" FontAttributes="Bold">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding SelectedCategory}" Value="Popular"><Setter Property="TextColor" Value="White" /></DataTrigger></Label.Triggers>
                            </Label>
                        </Border>

                        <Border Padding="18,12" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Food"/></Border.GestureRecognizers>
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedCategory}" Value="Food"><Setter Property="BackgroundColor" Value="#4F46E5" /><Setter Property="Stroke" Value="Transparent" /></DataTrigger>
                            </Border.Triggers>
                            <Label Text="Ẩm thực" TextColor="#4B5563" FontAttributes="Bold">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding SelectedCategory}" Value="Food"><Setter Property="TextColor" Value="White" /></DataTrigger></Label.Triggers>
                            </Label>
                        </Border>

                        <Border Padding="18,12" BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Shopping"/></Border.GestureRecognizers>
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedCategory}" Value="Shopping"><Setter Property="BackgroundColor" Value="#4F46E5" /><Setter Property="Stroke" Value="Transparent" /></DataTrigger>
                            </Border.Triggers>
                            <Label Text="Mua sắm" TextColor="#4B5563" FontAttributes="Bold">
                                <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding SelectedCategory}" Value="Shopping"><Setter Property="TextColor" Value="White" /></DataTrigger></Label.Triggers>
                            </Label>
                        </Border>

                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="Đề xuất cho bạn" FontSize="20" FontAttributes="Bold" TextColor="#111827" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Xem tất cả" TextColor="#4F46E5" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>
                
                <CollectionView ItemsSource="{Binding DisplayPlaces}" HeightRequest="350" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="20" />
                    </CollectionView.ItemsLayout>
                    
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="270" HeightRequest="320" BackgroundColor="White" StrokeThickness="0">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCardTapped" /></Border.GestureRecognizers>
                                <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#9CA3AF" Offset="0,15" Radius="25" Opacity="0.15" /></Border.Shadow>
                                
                                <Grid RowDefinitions="*, Auto">
                                    
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    
                                    <Grid Grid.Row="1" Padding="20">
                                        <VerticalStackLayout Spacing="5">
                                            
                                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="#111827"/>
                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="📍" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Location}" FontSize="13" TextColor="#6B7280" />
                                            </HorizontalStackLayout>
                                            
                                            <HorizontalStackLayout Spacing="5" Margin="0,8,0,0">
                                                <Label Text="⭐️" FontSize="12" VerticalOptions="Center"/>
                                                <Label Text="{Binding Rating}" FontSize="14" TextColor="#F59E0B" FontAttributes="Bold" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>