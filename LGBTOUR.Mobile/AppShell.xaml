<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LGBTOUR.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:LGBTOUR.Mobile"
    Shell.FlyoutBehavior="Disabled">

    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="TabBar">
                <Setter Property="Shell.TabBarBackgroundColor" Value="#FFFFFF" />
                <Setter Property="Shell.TabBarTitleColor" Value="#4F46E5" /> 
                <Setter Property="Shell.TabBarUnselectedColor" Value="#9CA3AF" /> 
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <Tab Title="Trang chủ" Icon="icon_home.png">
            <ShellContent 
                ContentTemplate="{DataTemplate local:MainPage}" 
                Route="MainPage" />
        </Tab>

        <Tab Title="Khám phá" Icon="icon_map.png">
            <ShellContent ContentTemplate="{DataTemplate local:MapPage}" />
        </Tab>

        <Tab Title="Tài khoản" Icon="icon_profile.png">
            <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>