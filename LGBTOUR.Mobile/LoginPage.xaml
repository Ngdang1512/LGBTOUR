<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LGBTOUR.Mobile.LoginPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="30, 80, 30, 40" Spacing="25">
            
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,0,0,40">
                <Border WidthRequest="80" HeightRequest="80" BackgroundColor="#4F46E5" StrokeThickness="0">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Label Text="✈️" FontSize="40" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Text="LGBTOUR" FontSize="28" FontAttributes="Bold" TextColor="#111827" HorizontalOptions="Center"/>
                <Label Text="Khám phá thế giới cùng chúng tôi" TextColor="#6B7280" FontSize="14" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="15">
                <Label Text="Email" TextColor="#374151" FontAttributes="Bold" FontSize="14"/>
                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" Padding="15,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Placeholder="nhap@email.com" Keyboard="Email" TextColor="#111827" BackgroundColor="Transparent"/>
                </Border>

                <Label Text="Mật khẩu" TextColor="#374151" FontAttributes="Bold" FontSize="14" Margin="0,10,0,0"/>
                <Border BackgroundColor="#F3F4F6" StrokeThickness="0" Padding="15,5">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry Placeholder="••••••••" IsPassword="True" TextColor="#111827" BackgroundColor="Transparent"/>
                </Border>
                
                <Label Text="Quên mật khẩu?" TextColor="#4F46E5" FontSize="14" FontAttributes="Bold" HorizontalOptions="End" Margin="0,5,0,20"/>

                <Button Text="ĐĂNG NHẬP" BackgroundColor="#4F46E5" TextColor="White" FontAttributes="Bold" 
                        CornerRadius="14" HeightRequest="55" Clicked="OnLoginClicked"/>
            </VerticalStackLayout>

            <Border BackgroundColor="#EEF2FF" StrokeThickness="0" HeightRequest="50" Margin="0,20,0,0">
                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSkipTapped" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="🚀" FontSize="18" VerticalOptions="Center"/>
                    <Label Text="Bỏ qua &amp; Khám phá ngay" TextColor="#4F46E5" FontAttributes="Bold" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>