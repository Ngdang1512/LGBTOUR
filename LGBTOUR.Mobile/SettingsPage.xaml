<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LGBTOUR.Mobile.SettingsPage"
             BackgroundColor="#F4F6F8"
             Shell.NavBarIsVisible="False">

    <ScrollView ShowsVerticalScrollIndicator="False">
        <VerticalStackLayout Spacing="0">
            
            <Grid HeightRequest="240" BackgroundColor="#4F46E5" Padding="20, 60, 20, 20">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border WidthRequest="90" HeightRequest="90" StrokeShape="RoundRectangle 45" StrokeThickness="3" Stroke="White">
                        <Image Source="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&amp;fit=crop&amp;w=200&amp;q=80" Aspect="AspectFill" />
                    </Border>
                    <Label Text="Du khách VIP" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                    <Label Text="thanhvien@lgbtour.vn" TextColor="#E0E7FF" FontSize="14" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="20" Spacing="25" Margin="0,-20,0,0">
                
                <Border BackgroundColor="White" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#9CA3AF" Offset="0,4" Radius="10" Opacity="0.05"/></Border.Shadow>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Text="👤" FontSize="20" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Thông tin cá nhân" TextColor="#111827" FontSize="16" Margin="15,0,0,0" VerticalOptions="Center"/>
                            <Label Grid.Column="2" Text=">" TextColor="#9CA3AF" FontSize="18" VerticalOptions="Center"/>
                        </Grid>
                        <BoxView HeightRequest="1" Color="#F3F4F6"/>
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Label Text="🔔" FontSize="20" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Nhận thông báo" TextColor="#111827" FontSize="16" Margin="15,0,0,0" VerticalOptions="Center"/>
                            <Switch Grid.Column="2" IsToggled="True" OnColor="#4F46E5"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <Label Text="CHUNG" TextColor="#6B7280" FontSize="13" FontAttributes="Bold" Margin="5,0,0,0"/>
                    <Border BackgroundColor="White" StrokeThickness="0" Padding="15">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#9CA3AF" Offset="0,4" Radius="10" Opacity="0.05"/></Border.Shadow>
                        <VerticalStackLayout Spacing="15">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Text="🌐" FontSize="20" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Ngôn ngữ" TextColor="#111827" FontSize="16" Margin="15,0,0,0" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="2" Spacing="5">
                                    <Label Text="Tiếng Việt" TextColor="#6B7280" VerticalOptions="Center"/>
                                    <Label Text=">" TextColor="#9CA3AF" FontSize="18" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F3F4F6"/>
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Text="🎧" FontSize="20" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Trung tâm trợ giúp" TextColor="#111827" FontSize="16" Margin="15,0,0,0" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text=">" TextColor="#9CA3AF" FontSize="18" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button Text="Đăng xuất" BackgroundColor="#FEE2E2" TextColor="#EF4444" FontAttributes="Bold" CornerRadius="16" HeightRequest="55" Margin="0,10,0,20"/>
                
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>