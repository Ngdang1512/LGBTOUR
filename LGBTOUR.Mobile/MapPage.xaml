<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LGBTOUR.Mobile.MapPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F4F6F8">

    <Grid RowDefinitions="*, Auto">
        
        <WebView Grid.Row="0" HorizontalOptions="Fill" VerticalOptions="Fill">
            <WebView.Source>
                <HtmlWebViewSource>
                    <HtmlWebViewSource.Html>
                        <![CDATA[
                        <body style="margin:0; padding:0; overflow:hidden;">
                            <iframe width="100%" height="100%" frameborder="0" style="border:0;" 
                                    src="https://maps.google.com/maps?q=Quận+1,+Hồ+Chí+Minh,+Việt+Nam&z=15&output=embed" 
                                    allowfullscreen>
                            </iframe>
                        </body>
                        ]]>
                    </HtmlWebViewSource.Html>
                </HtmlWebViewSource>
            </WebView.Source>
        </WebView>

        <Border Grid.Row="0" Margin="20,50,0,0" WidthRequest="44" HeightRequest="44" 
                HorizontalOptions="Start" VerticalOptions="Start" BackgroundColor="White" StrokeThickness="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.2"/></Border.Shadow>
            <Label Text="←" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Black"/>
        </Border>

        <Border Grid.Row="1" BackgroundColor="White" Padding="20, 25, 20, 30" 
                Margin="0,-20,0,0" StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30,30,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,-5" Radius="20" Opacity="0.1"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="15">
                <BoxView HeightRequest="4" WidthRequest="40" Color="#E5E7EB" 
                         CornerRadius="2" HorizontalOptions="Center" Margin="0,-10,0,10"/>

                <Grid ColumnDefinitions="*, Auto">
                    <Label Text="5KM" FontSize="24" FontAttributes="Bold" TextColor="#111827"/>
                    <Border Grid.Column="1" BackgroundColor="#EEF2FF" Padding="10,5" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                        <Label Text="8 điểm tham quan" TextColor="#4F46E5" FontSize="12" FontAttributes="Bold"/>
                    </Border>
                </Grid>

                <HorizontalStackLayout Spacing="5">
                    <Label Text="⏱" FontSize="14" VerticalOptions="Center"/>
                    <Label Text="1 tiếng" TextColor="#4B5563" FontSize="14" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <Label Text="Chi tiết" FontSize="18" FontAttributes="Bold" TextColor="#111827" Margin="0,10,0,5"/>

                <CollectionView ItemsSource="{Binding RoutePlaces}" HeightRequest="130">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout WidthRequest="110" Spacing="8">
                                <Border HeightRequest="80" StrokeThickness="0">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                </Border>
                                <Label Text="{Binding Name}" FontSize="12" TextColor="#111827" FontAttributes="Bold" 
                                       MaxLines="2" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>