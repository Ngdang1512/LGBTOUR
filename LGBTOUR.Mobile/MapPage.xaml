<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LGBTOUR.Mobile.MapPage"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        
        <VerticalStackLayout Grid.Row="0" Padding="20, 50, 20, 20" Spacing="5">
            <Label Text="Lộ trình di chuyển" TextColor="#0F172A" FontSize="28" FontAttributes="Bold" />
            <Label Text="Tuyến xe buýt 2 tầng vòng quanh thành phố" TextColor="#64748B" FontSize="15" />
        </VerticalStackLayout>

        <Border Grid.Row="1" Margin="20, 0, 20, 20" Stroke="#E2E8F0" StrokeThickness="1" BackgroundColor="White">
            <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#64748B" Offset="0,8" Radius="15" Opacity="0.1" /></Border.Shadow>
            
            <WebView x:Name="MapWebView" />
            
        </Border>
    </Grid>

</ContentPage>