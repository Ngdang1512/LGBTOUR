@{
    ViewData["Title"] = "Sắp xếp Lộ trình Tuyến Xe";
}

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title font-weight-bold mb-0"><i class="fas fa-route mr-1"></i> Cấu hình Lộ trình: Tuyến Bus 2 Tầng Trung Tâm Q1</h3>
    </div>
    
    <div class="card-body bg-light">
        <div class="row">
            <div class="col-md-5">
                <h5 class="text-secondary font-weight-bold mb-3"><i class="fas fa-warehouse"></i> Kho Trạm (Kéo để chọn)</h5>
                <div id="availablePois" class="list-group min-vh-50" style="min-height: 400px; border: 2px dashed #ccc; border-radius: 8px; padding: 10px; background: white;">
                    
                    <div class="list-group-item list-group-item-action cursor-grab mb-2 border rounded shadow-sm" data-id="4">
                        <i class="fas fa-grip-vertical text-muted mr-2"></i> Chợ Bến Thành
                    </div>
                    <div class="list-group-item list-group-item-action cursor-grab mb-2 border rounded shadow-sm" data-id="8">
                        <i class="fas fa-grip-vertical text-muted mr-2"></i> Phố Bùi Viện
                    </div>
                    <div class="list-group-item list-group-item-action cursor-grab mb-2 border rounded shadow-sm" data-id="6">
                        <i class="fas fa-grip-vertical text-muted mr-2"></i> Phố đi bộ Nguyễn Huệ
                    </div>

                </div>
            </div>

            <div class="col-md-2 d-flex align-items-center justify-content-center flex-column">
                <i class="fas fa-exchange-alt fa-3x text-muted opacity-50"></i>
                <small class="text-muted mt-2 text-center">Kéo thả qua lại<br>để sắp xếp</small>
            </div>

            <div class="col-md-5">
                <h5 class="text-success font-weight-bold mb-3"><i class="fas fa-bus-alt"></i> Lộ trình Xe chạy (Từ trên xuống)</h5>
                
                <form asp-action="SaveRoute" method="post" id="routeForm">
                    <input type="hidden" name="TourId" value="1" />
                    <input type="hidden" id="OrderedPoiIds" name="OrderedPoiIds" value="" />
                    
                    <div id="tourRoute" class="list-group" style="min-height: 400px; border: 2px solid #28a745; border-radius: 8px; padding: 10px; background: #f8fff9;">
                        
                        <div class="list-group-item list-group-item-success cursor-grab mb-2 border rounded shadow-sm" data-id="1">
                            <span class="badge badge-success mr-2 badge-order">1</span> Dinh Độc Lập
                        </div>
                        <div class="list-group-item list-group-item-success cursor-grab mb-2 border rounded shadow-sm" data-id="2">
                            <span class="badge badge-success mr-2 badge-order">2</span> Nhà thờ Đức Bà
                        </div>
                        <div class="list-group-item list-group-item-success cursor-grab mb-2 border rounded shadow-sm" data-id="3">
                            <span class="badge badge-success mr-2 badge-order">3</span> Bưu điện Trung tâm
                        </div>

                    </div>
                    
                    <button type="submit" class="btn btn-success btn-lg btn-block mt-4 font-weight-bold shadow">
                        <i class="fas fa-save mr-1"></i> Lưu Lộ Trình Mới
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    /* Làm con trỏ chuột thành hình bàn tay để biết là kéo thả được */
    .cursor-grab { cursor: grab; }
    .cursor-grab:active { cursor: grabbing; }
    /* Hiệu ứng mờ khi đang cầm kéo đi */
    .sortable-ghost { opacity: 0.4; background-color: #f8f9fa; }
</style>

@section Scripts {
    <script>
        // 1. Kích hoạt Kéo Thả cho Kho Trạm (Cột trái)
        var availableList = document.getElementById('availablePois');
        new Sortable(availableList, {
            group: 'shared', // Cùng tên group thì kéo qua lại cho nhau được
            animation: 150,
            ghostClass: 'sortable-ghost'
        });

        // 2. Kích hoạt Kéo Thả cho Lộ Trình (Cột phải)
        var routeList = document.getElementById('tourRoute');
        var routeSortable = new Sortable(routeList, {
            group: 'shared',
            animation: 150,
            ghostClass: 'sortable-ghost',
            onSort: function (evt) {
                // Mỗi khi kéo thả xong, tự động cập nhật lại Số thứ tự (1, 2, 3...)
                updateOrderNumbers();
                updateHiddenInput();
            }
        });

        // 3. Hàm cập nhật Số Thứ Tự hiển thị cho đẹp
        function updateOrderNumbers() {
            var items = routeList.querySelectorAll('.list-group-item');
            items.forEach((item, index) => {
                // Đổi class màu sắc để biết nó đã vào Tuyến
                item.classList.replace('list-group-item-action', 'list-group-item-success');
                
                // Cập nhật số thứ tự hoặc tạo mới cục Badge số
                let badge = item.querySelector('.badge-order');
                if(!badge) {
                    badge = document.createElement('span');
                    badge.className = 'badge badge-success mr-2 badge-order';
                    item.prepend(badge);
                }
                badge.innerText = index + 1;
            });

            // Nếu kéo ngược lại kho thì xóa class xanh, xóa số
            var availableItems = availableList.querySelectorAll('.list-group-item');
            availableItems.forEach(item => {
                item.classList.replace('list-group-item-success', 'list-group-item-action');
                let badge = item.querySelector('.badge-order');
                if(badge) badge.remove();
            });
        }

        // 4. Hàm thu thập dữ liệu gửi về C#
        function updateHiddenInput() {
            // Lấy tất cả thuộc tính data-id của các trạm đang nằm cột phải
            var finalOrderIds = routeSortable.toArray(); 
            
            // Nhét vào thẻ input ẩn, VD kết quả: "1,2,3,6,8"
            document.getElementById('OrderedPoiIds').value = finalOrderIds.join(',');
            console.log("Sẵn sàng gửi về DB chuỗi ID:", finalOrderIds.join(','));
        }

        // Chạy lần đầu lúc load trang
        updateHiddenInput();
    </script>
}