@model SaigonAudioTour.AdminWeb.Models.TourRouteViewModel
@{
    ViewData["Title"] = "Sắp xếp Lộ trình Tuyến Xe";
}

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title font-weight-bold mb-0"><i class="fas fa-route mr-1"></i> Cấu hình Lộ trình: @Model.TourName</h3>
    </div>

    <div class="card-body bg-light">
        <div class="row">
            <div class="col-md-5">
                <h5 class="text-secondary font-weight-bold mb-3"><i class="fas fa-warehouse"></i> Kho Trạm (Kéo để chọn)</h5>
                <div id="availablePois" class="list-group min-vh-50" style="min-height: 400px; border: 2px dashed #ccc; border-radius: 8px; padding: 10px; background: white;">
                    @foreach (var poi in Model.AvailablePois)
                    {
                        <div class="list-group-item list-group-item-action cursor-grab mb-2 border rounded shadow-sm" data-id="@poi.Id">
                            <i class="fas fa-grip-vertical text-muted mr-2"></i> @poi.Name
                        </div>
                    }
                    @if (!Model.AvailablePois.Any())
                    {
                        <p class="text-muted text-center mt-3"><small>Tất cả trạm đã có trong lộ trình</small></p>
                    }
                </div>
            </div>

            <div class="col-md-2 d-flex align-items-center justify-content-center flex-column">
                <i class="fas fa-exchange-alt fa-3x text-muted opacity-50"></i>
                <small class="text-muted mt-2 text-center">Kéo thả qua lại<br>để sắp xếp</small>
            </div>

            <div class="col-md-5">
                <h5 class="text-success font-weight-bold mb-3"><i class="fas fa-bus-alt"></i> Lộ trình Xe chạy (Từ trên xuống)</h5>

                <form asp-action="SaveRoute" method="post" id="routeForm">
                    <input type="hidden" name="TourId" value="@Model.TourId" />
                    <input type="hidden" id="OrderedPoiIds" name="OrderedPoiIds" value="" />

                    <div id="tourRoute" class="list-group" style="min-height: 400px; border: 2px solid #28a745; border-radius: 8px; padding: 10px; background: #f8fff9;">
                        @{ int order = 1; }
                        @foreach (var poi in Model.RoutePois)
                        {
                            <div class="list-group-item list-group-item-success cursor-grab mb-2 border rounded shadow-sm" data-id="@poi.Id">
                                <span class="badge badge-success mr-2 badge-order">@order</span> @poi.Name
                            </div>
                            order++;
                        }
                        @if (!Model.RoutePois.Any())
                        {
                            <p class="text-muted text-center mt-3"><small>Kéo trạm từ bên trái vào đây</small></p>
                        }
                    </div>

                    <button type="submit" class="btn btn-success btn-lg btn-block mt-4 font-weight-bold shadow">
                        <i class="fas fa-save mr-1"></i> Lưu Lộ Trình Mới
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="card-footer bg-white">
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
        </a>
    </div>
</div>

<style>
    .cursor-grab { cursor: grab; }
    .cursor-grab:active { cursor: grabbing; }
    .sortable-ghost { opacity: 0.4; background-color: #f8f9fa; }
</style>

@section Scripts {
    <script>
        var availableList = document.getElementById('availablePois');
        new Sortable(availableList, {
            group: 'shared',
            animation: 150,
            ghostClass: 'sortable-ghost'
        });

        var routeList = document.getElementById('tourRoute');
        var routeSortable = new Sortable(routeList, {
            group: 'shared',
            animation: 150,
            ghostClass: 'sortable-ghost',
            onSort: function (evt) {
                updateOrderNumbers();
                updateHiddenInput();
            }
        });

        function updateOrderNumbers() {
            routeList.querySelectorAll('.list-group-item').forEach((item, index) => {
                item.classList.replace('list-group-item-action', 'list-group-item-success');
                let badge = item.querySelector('.badge-order');
                if (!badge) {
                    badge = document.createElement('span');
                    badge.className = 'badge badge-success mr-2 badge-order';
                    item.prepend(badge);
                }
                badge.innerText = index + 1;
            });

            availableList.querySelectorAll('.list-group-item').forEach(item => {
                item.classList.replace('list-group-item-success', 'list-group-item-action');
                let badge = item.querySelector('.badge-order');
                if (badge) badge.remove();
            });
        }

        function updateHiddenInput() {
            document.getElementById('OrderedPoiIds').value = routeSortable.toArray().join(',');
        }

        // Khởi tạo khi load trang
        updateHiddenInput();

        // Validate trước khi submit: phải có ít nhất 1 trạm trong lộ trình
        document.getElementById('routeForm').addEventListener('submit', function (e) {
            if (routeSortable.toArray().length === 0) {
                e.preventDefault();
                alert('Lộ trình phải có ít nhất 1 trạm!');
            }
        });
    </script>
}
