@model SaigonAudioTour.AdminWeb.Models.TourViewModel
@{
    ViewData["Title"] = "Sửa Tuyến Xe";
}

<div class="row mt-3">
    <div class="col-md-8 mx-auto">
        <div class="card card-secondary shadow-sm border-0">
            <div class="card-header">
                <h3 class="card-title font-weight-bold"><i class="fas fa-edit mr-2"></i> Cập Nhật Lộ Trình: @Model.Name</h3>
            </div>
            
            <form asp-action="Edit" method="post">
                <div class="card-body">
                    <input type="hidden" asp-for="Id" />
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger px-2 py-1">@ViewBag.Error</div>
                    }

                    <div class="form-group">
                        <label asp-for="Name" class="font-weight-bold">Tên Tuyến Xe <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="font-weight-bold">Mô Tả Lộ Trình</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4 form-group">
                            <label asp-for="EstimatedTimeMinutes" class="font-weight-bold">Thời Gian (Phút) <span class="text-danger">*</span></label>
                            <input asp-for="EstimatedTimeMinutes" type="number" class="form-control" required />
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="TotalDistanceKm" class="font-weight-bold">Quãng Đường (Km) <span class="text-danger">*</span></label>
                            <input asp-for="TotalDistanceKm" type="number" step="0.1" class="form-control" required />
                        </div>
                        <div class="col-md-4 form-group">
                            <label asp-for="TicketPrice" class="font-weight-bold">Giá Vé (VNĐ) <span class="text-danger">*</span></label>
                            <input asp-for="TicketPrice" type="number" class="form-control" required />
                        </div>
                    </div>
                </div>
                
                <div class="card-footer bg-white text-right">
                    <a asp-action="Index" class="btn btn-default mr-2 font-weight-bold">Hủy Bỏ</a>
                    <button type="submit" class="btn btn-secondary font-weight-bold">
                        <i class="fas fa-save mr-1"></i> Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>