@model IEnumerable<SaigonAudioTour.AdminWeb.Models.PoiViewModel>
@{
    ViewData["Title"] = "Quản lý Điểm đến (POI)";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h3 class="card-title font-weight-bold m-0 text-danger">
            <i class="fas fa-map-marker-alt mr-2"></i> Danh sách Trạm Dừng / Điểm Tham Quan
        </h3>
        <a asp-action="Create" class="btn btn-primary btn-sm ml-auto font-weight-bold">
            <i class="fas fa-plus mr-1"></i> Thêm Địa Điểm Mới
        </a>
    </div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped m-0">
            <thead class="bg-light">
                <tr>
                    <th width="50" class="text-center">ID</th>
                    <th width="100" class="text-center">Hình ảnh</th>
                    <th>Tên địa điểm</th>
                    <th class="text-center">Loại</th>
                    <th class="text-center">Audio</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center py-4 text-muted">Chưa có dữ liệu điểm đến nào trong hệ thống.</td></tr>
                }
                
                @foreach (var item in Model)
                {
                    var imageUrl = string.Empty;
                    var rawImage = item.Image;
                    if (!string.IsNullOrWhiteSpace(rawImage))
                    {
                        var normalizedImage = rawImage.Trim();
                        imageUrl = normalizedImage.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                            ? normalizedImage
                            : $"http://localhost:5117{(normalizedImage.StartsWith("/") ? normalizedImage : "/" + normalizedImage)}";
                    }
                    <tr>
                        <td class="align-middle text-center fw-bold">@item.Id</td>
                        <td class="align-middle text-center">
                            @if (!string.IsNullOrWhiteSpace(imageUrl))
                            {
                                <img src="@imageUrl"
                                     alt="IMG"
                                     class="img-thumbnail"
                                     style="width: 60px; height: 60px; object-fit: cover;"
                                     loading="lazy"
                                     onerror="this.onerror=null;this.src='https://via.placeholder.com/60x60?text=No+Image';" />
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex justify-content-center align-items-center rounded" style="width: 60px; height: 60px; font-size: 10px;">No Image</div>
                            }
                        </td>
                        <td class="align-middle font-weight-bold text-primary">
                            @item.Name
                            <div class="text-muted font-weight-normal" style="font-size: 0.85rem;">
                                Bán kính: <span class="text-danger fw-bold">@item.Radius m</span> | Ưu tiên: @item.Priority
                            </div>
                        </td>
                        <td class="align-middle text-center">
                            @if (item.IsStopStation)
                            {
                                <span class="badge badge-success px-2 py-1"><i class="fas fa-bus"></i> Trạm Dừng</span>
                            }
                            else
                            {
                                <span class="badge badge-warning px-2 py-1">Đi Ngang</span>
                            }
                        </td>
                        <td class="align-middle text-center">
                            <span class="badge badge-info px-2 py-1">@item.NarrationCount bài</span>
                        </td>
                        <td class="align-middle text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Sửa">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Xóa">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>