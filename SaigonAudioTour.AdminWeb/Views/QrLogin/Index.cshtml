@model SaigonAudioTour.AdminWeb.Models.QrLoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>SaigonAudioTour QR Web Demo</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h4 class="mb-3">QR Login Web Demo</h4>
                        <p class="text-muted small mb-4">Trang này cho demo/chấm đồ án: quét QR mở webapp và đăng nhập nhanh, không cần cài mobile app.</p>

                        @if (!Model.HasInput)
                        {
                            <div class="alert alert-warning">
                                @Model.Message
                                <div class="mt-2 small">
                                    Ví dụ: <code>/demo-login?u=demo.free%40saigontour.local&p=Demo%40123&plan=FREE</code>
                                </div>
                            </div>
                        }
                        else if (!Model.IsSuccess)
                        {
                            <div class="alert alert-danger">@Model.Message</div>
                        }
                        else
                        {
                            <div class="alert alert-success">@Model.Message</div>
                            <ul class="list-group mb-3">
                                <li class="list-group-item"><strong>User:</strong> @Model.FullName (@Model.Email)</li>
                                <li class="list-group-item"><strong>UserId:</strong> @Model.UserId</li>
                                <li class="list-group-item"><strong>Subscription:</strong> @Model.SubscriptionStatus</li>
                                @if (!string.IsNullOrWhiteSpace(Model.InputPlanHint))
                                {
                                    <li class="list-group-item">
                                        <strong>So khớp plan từ QR:</strong>
                                        @if (Model.PlanMatchesHint)
                                        {
                                            <span class="text-success">Đúng (@Model.InputPlanHint)</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">Không khớp (QR=@Model.InputPlanHint, profile=@Model.SubscriptionStatus)</span>
                                        }
                                    </li>
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.TokenPreview))
                                {
                                    <li class="list-group-item"><strong>Token:</strong> <span class="small">@Model.TokenPreview</span></li>
                                }
                            </ul>
                        }

                        <div class="d-flex justify-content-between">
                            <a class="btn btn-outline-secondary" href="/Auth/Login">Admin Login</a>
                            <a class="btn btn-primary" href="/Analytics/Dashboard">Mở Analytics Dashboard</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
