@model SaigonAudioTour.AdminWeb.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập — Saigon Audio Tour Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
            -webkit-font-smoothing: antialiased;
            min-height: 100dvh;
            display: flex;
            background: #0f172a;
            overflow: hidden;
        }

        /* Left panel — branding */
        .login-left {
            display: none;
            flex-direction: column;
            justify-content: center;
            padding: 48px 56px;
            background: linear-gradient(145deg, #1e1b4b 0%, #0f172a 60%, #0c1445 100%);
            position: relative;
            overflow: hidden;
        }
        @media (min-width: 900px) { .login-left { display: flex; flex: 1; } }

        .login-left::before {
            content: '';
            position: absolute;
            inset: 0;
            background:
                radial-gradient(circle at 20% 30%, rgba(99,102,241,.18) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(139,92,246,.12) 0%, transparent 50%);
        }
        .login-left > * { position: relative; z-index: 1; }

        .brand-icon {
            width: 52px; height: 52px; border-radius: 14px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
            box-shadow: 0 4px 20px rgba(99,102,241,.4);
            margin-bottom: 36px;
        }
        .brand-icon i { color: #fff; font-size: 1.3rem; }

        .brand-title {
            font-size: 1.8rem; font-weight: 700; color: #f1f5f9;
            line-height: 1.2; margin-bottom: 12px;
            letter-spacing: -.02em;
        }
        .brand-sub {
            font-size: .92rem; color: rgba(148,163,184,.7);
            line-height: 1.6; max-width: 340px;
        }

        .feature-list {
            margin-top: 48px;
            display: flex; flex-direction: column; gap: 14px;
        }
        .feature-item {
            display: flex; align-items: center; gap: 12px;
        }
        .feature-dot {
            width: 8px; height: 8px; border-radius: 50%;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            flex-shrink: 0;
        }
        .feature-item span { font-size: .82rem; color: rgba(148,163,184,.65); }

        /* Right panel — form */
        .login-right {
            flex: 0 0 440px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 32px 40px;
            background: #fff;
            position: relative;
        }
        @media (max-width: 899px) { .login-right { flex: 1; padding: 32px 24px; } }

        .login-form-wrap {
            width: 100%;
            max-width: 340px;
        }

        .login-logo-mobile {
            display: none;
            align-items: center;
            gap: 12px;
            margin-bottom: 36px;
        }
        @media (max-width: 899px) { .login-logo-mobile { display: flex; } }
        .login-logo-mobile .mini-icon {
            width: 38px; height: 38px; border-radius: 10px;
            background: linear-gradient(135deg, #6366f1, #8b5cf6);
            display: flex; align-items: center; justify-content: center;
        }
        .login-logo-mobile .mini-icon i { color: #fff; font-size: .9rem; }
        .login-logo-mobile span { font-size: .85rem; font-weight: 700; color: #0f172a; letter-spacing: -.01em; }

        .form-heading { margin-bottom: 28px; }
        .form-heading h1 {
            font-size: 1.45rem; font-weight: 700; color: #0f172a;
            letter-spacing: -.02em; margin-bottom: 6px;
        }
        .form-heading p { font-size: .82rem; color: #64748b; }

        .field-label {
            display: block;
            font-size: .78rem; font-weight: 600;
            color: #374151; margin-bottom: 6px;
            letter-spacing: .01em;
        }

        .input-wrap {
            position: relative; margin-bottom: 16px;
        }
        .input-wrap .input-icon {
            position: absolute; left: 12px; top: 50%;
            transform: translateY(-50%);
            color: #94a3b8; font-size: .82rem; pointer-events: none;
        }
        .input-wrap input {
            width: 100%;
            padding: .65rem .75rem .65rem 2.4rem;
            border: 1.5px solid #e2e8f0;
            border-radius: 8px;
            font-size: .87rem; color: #0f172a;
            font-family: inherit;
            background: #f8fafc;
            outline: none;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }
        .input-wrap input:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99,102,241,.12);
            background: #fff;
        }
        .input-wrap input::placeholder { color: #cbd5e1; }

        .toggle-pw {
            position: absolute; right: 12px; top: 50%;
            transform: translateY(-50%);
            color: #94a3b8; cursor: pointer; font-size: .82rem;
            background: none; border: none; padding: 2px;
            transition: color .15s;
        }
        .toggle-pw:hover { color: #475569; }

        .error-alert {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            border-radius: 7px;
            padding: 10px 14px;
            font-size: .8rem;
            margin-bottom: 18px;
            display: flex; align-items: center; gap: 8px;
        }

        .btn-login {
            width: 100%;
            padding: .7rem;
            background: linear-gradient(135deg, #6366f1, #7c3aed);
            border: none; border-radius: 8px;
            color: #fff;
            font-size: .88rem; font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            letter-spacing: .01em;
            transition: opacity .15s, transform .1s, box-shadow .15s;
            box-shadow: 0 4px 14px rgba(99,102,241,.3);
            display: flex; align-items: center; justify-content: center; gap: 8px;
            margin-top: 8px;
        }
        .btn-login:hover { opacity: .92; transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99,102,241,.35); }
        .btn-login:active { transform: translateY(0); }
        .btn-login:disabled { opacity: .6; cursor: not-allowed; transform: none; }

        .login-footer {
            position: absolute; bottom: 20px; left: 0; right: 0; text-align: center;
            font-size: .7rem; color: #cbd5e1;
        }

        /* Loading spinner inside button */
        .spinner { display: none; width: 14px; height: 14px; border-radius: 50%; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; animation: spin .6s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>

    <!-- Left branding panel -->
    <div class="login-left">
        <div class="brand-icon"><i class="fas fa-headphones-alt"></i></div>
        <div class="brand-title">Saigon Audio Tour<br>Admin Portal</div>
        <div class="brand-sub">Hệ thống quản trị tuyến bus âm thanh tự động — Quận 1, Thành phố Hồ Chí Minh</div>
        <div class="feature-list">
            <div class="feature-item"><div class="feature-dot"></div><span>Giám sát người dùng theo thời gian thực</span></div>
            <div class="feature-item"><div class="feature-dot"></div><span>Quản lý điểm tham quan & tuyến xe buýt</span></div>
            <div class="feature-item"><div class="feature-dot"></div><span>Upload & quản lý file thuyết minh âm thanh</span></div>
            <div class="feature-item"><div class="feature-dot"></div><span>Phân tích thống kê & báo cáo chi tiết</span></div>
        </div>
    </div>

    <!-- Right form panel -->
    <div class="login-right">
        <div class="login-form-wrap">

            <!-- Mobile only logo -->
            <div class="login-logo-mobile">
                <div class="mini-icon"><i class="fas fa-headphones-alt"></i></div>
                <span>Saigon Audio Tour Admin</span>
            </div>

            <div class="form-heading">
                <h1>Chào mừng trở lại</h1>
                <p>Nhập thông tin đăng nhập để tiếp tục</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="error-alert">
                    <i class="fas fa-exclamation-circle"></i>
                    @ViewBag.Error
                </div>
            }

            <form asp-action="Login" method="post" id="loginForm">
                <div>
                    <label class="field-label" for="Username">Tên đăng nhập</label>
                    <div class="input-wrap">
                        <i class="fas fa-user input-icon"></i>
                        <input asp-for="Username" id="Username" placeholder="Nhập tên đăng nhập" autocomplete="username" />
                    </div>
                </div>
                <div>
                    <label class="field-label" for="Password">Mật khẩu</label>
                    <div class="input-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input asp-for="Password" id="Password" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                        <button type="button" class="toggle-pw" id="togglePw" aria-label="Hiển thị/ẩn mật khẩu">
                            <i class="fas fa-eye" id="togglePwIcon"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn-login" id="btnLogin">
                    <span class="spinner" id="loginSpinner"></span>
                    <i class="fas fa-sign-in-alt" id="loginIcon"></i>
                    <span id="loginText">Đăng nhập</span>
                </button>
            </form>
        </div>

        <div class="login-footer">&copy; 2026 Saigon Audio Tour — Đồ án tốt nghiệp C#</div>
    </div>

    <script>
        // Toggle password visibility
        const togglePw   = document.getElementById('togglePw');
        const pwInput    = document.getElementById('Password');
        const toggleIcon = document.getElementById('togglePwIcon');
        if (togglePw) {
            togglePw.addEventListener('click', function () {
                const show = pwInput.type === 'password';
                pwInput.type = show ? 'text' : 'password';
                toggleIcon.className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
            });
        }

        // Submit spinner
        const form       = document.getElementById('loginForm');
        const btn        = document.getElementById('btnLogin');
        const spinner    = document.getElementById('loginSpinner');
        const loginIcon  = document.getElementById('loginIcon');
        const loginText  = document.getElementById('loginText');
        if (form) {
            form.addEventListener('submit', function () {
                btn.disabled = true;
                spinner.style.display = 'block';
                loginIcon.style.display = 'none';
                loginText.textContent = 'Đang đăng nhập…';
            });
        }
    </script>
</body>
</html>
