<!-- Tích hợp Live Radar (Real-time SignalR) -->
<partial name="_LiveRadar" />

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title">Top 5 Địa Điểm Được Quan Tâm Nhất</h3>
            </div>
            <div class="card-body">
                <canvas id="poiChart" height="150"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var statsData = @Html.Raw(ViewBag.Stats ?? "[]");
        var labels = statsData.map(x => x.poiName);
        var counts = statsData.map(x => x.totalListens);

        new Chart(document.getElementById('poiChart'), {
        type: 'bar',
        data: {
        labels: labels,
        datasets: [{
        label: 'Số lượt nghe thuyết minh',
        data: counts,
        backgroundColor: 'rgba(54, 162, 235, 0.6)',
        borderColor: 'rgb(54, 162, 235)',
        borderWidth: 1
        }]
        }
        });
    </script>
}