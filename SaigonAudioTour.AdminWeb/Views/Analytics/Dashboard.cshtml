@model SaigonAudioTour.AdminWeb.Controllers.HeatmapData
@{
    ViewData["Title"] = "Analytics Dashboard";
    var revenue = ViewBag.RevenueSummary as SaigonAudioTour.AdminWeb.Controllers.RevenueSummary
        ?? new SaigonAudioTour.AdminWeb.Controllers.RevenueSummary();
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>📊 Analytics Dashboard</h1>
            <p class="text-muted">Heatmap & thống kê lượt nghe theo POI</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.Error))
    {
        <div class="alert alert-warning">
            <strong>⚠️ Cảnh báo:</strong> @ViewBag.Error
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Doanh thu 7 ngày</small>
                    <h4 class="text-success mb-0" id="kpiRevenue">@revenue.TotalRevenue.ToString("N0") đ</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Vé đã bán</small>
                    <h4 class="mb-0" id="kpiTickets">@revenue.TicketsSold</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Premium hiện tại</small>
                    <h4 class="text-primary mb-0" id="kpiPremiumUsers">@revenue.ActivePremiumUsers/@revenue.TotalUsers</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <small class="text-muted">Tỷ lệ chuyển đổi</small>
                    <h4 class="mb-0" id="kpiConversion">@revenue.ConversionRate.ToString("0.##")%</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">💰 Xu hướng doanh thu & mua Premium (7 ngày)</h5>
                </div>
                <div class="card-body">
                    <canvas id="revenueTrendChart" style="max-height: 320px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Heatmap Chart -->
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📈 Biểu đồ Lượt Nghe & Thời Gian TB</h5>
                </div>
                <div class="card-body">
                    <canvas id="heatmapChart" style="max-height: 400px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Summary Stats -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">📍 Tổng Cộng</h5>
                </div>
                <div class="card-body">
                    <p><strong>Tổng lượt nghe:</strong> <span id="totalListens">-</span></p>
                    <p><strong>Số POI hoạt động:</strong> <span id="activePois">-</span></p>
                    <p><strong>Thời gian TB:</strong> <span id="avgDurationGlobal">-</span>s</p>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">🏆 Top 5 POI</h5>
                </div>
                <div class="card-body">
                    <div id="topPoiList">
                        <p class="text-muted">Đang tải...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Table -->
    <div class="row mt-4">
        <div class="col">
            <div class="card shadow-sm">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">📋 Chi tiết theo POI</h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>POI</th>
                                <th>Lượt Nghe</th>
                                <th>Thời gian TB (giây)</th>
                                <th>% tổng nghe</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.Items != null && Model.Items.Count > 0)
                            {
                                var totalListens = Model.Items.Sum(x => x.VisitCount);
                                var index = 1;
                                @foreach (var item in Model.Items.OrderByDescending(x => x.VisitCount))
                                {
                                    var percentage = totalListens > 0 ? (item.VisitCount * 100 / totalListens) : 0;
                                    <tr>
                                        <td><strong>@index</strong></td>
                                        <td>@item.PoiName</td>
                                        <td><span class="badge bg-success">@item.VisitCount</span></td>
                                        <td>@item.AvgDuration</td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar" role="progressbar" style="width: @percentage%;" aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                                    @percentage%
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted">Không có dữ liệu</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        $(document).ready(function() {
            loadRevenueSummary();
            loadRevenueTrend();
            loadChartData();
            updateStats();
        });

        function loadRevenueSummary() {
            $.get('@Url.Action("RevenueSummary", "Analytics")?days=7', function(response) {
                if (!response || !response.success || !response.data) return;

                const d = response.data;
                $('#kpiRevenue').text((d.totalRevenue || 0).toLocaleString('vi-VN') + ' đ');
                $('#kpiTickets').text((d.ticketsSold || 0).toLocaleString('vi-VN'));
                $('#kpiPremiumUsers').text(`${d.activePremiumUsers || 0}/${d.totalUsers || 0}`);
                $('#kpiConversion').text(`${(d.conversionRate || 0).toLocaleString('vi-VN')}%`);
            });
        }

        function loadRevenueTrend() {
            $.get('@Url.Action("RevenueTrend", "Analytics")?days=7', function(response) {
                if (!response || !response.labels || response.labels.length === 0) return;

                const ctx = document.getElementById('revenueTrendChart').getContext('2d');
                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: response.labels,
                        datasets: [
                            {
                                label: 'Doanh thu (VND)',
                                data: response.datasets[0].data,
                                borderColor: 'rgb(34, 197, 94)',
                                backgroundColor: 'rgba(34, 197, 94, 0.2)',
                                yAxisID: 'yRevenue',
                                tension: 0.3
                            },
                            {
                                label: 'Mua Premium',
                                data: response.datasets[1].data,
                                type: 'bar',
                                borderColor: 'rgb(59, 130, 246)',
                                backgroundColor: 'rgba(59, 130, 246, 0.4)',
                                yAxisID: 'yCount'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'bottom' }
                        },
                        scales: {
                            yRevenue: {
                                type: 'linear',
                                position: 'left',
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) {
                                        return value.toLocaleString('vi-VN');
                                    }
                                }
                            },
                            yCount: {
                                type: 'linear',
                                position: 'right',
                                beginAtZero: true,
                                grid: {
                                    drawOnChartArea: false
                                }
                            }
                        }
                    }
                });
            });
        }

        function loadChartData() {
            $.get('@Url.Action("ChartData", "Analytics")', function(response) {
                if (response && response.labels && response.labels.length > 0) {
                    const ctx = document.getElementById('heatmapChart').getContext('2d');
                    new Chart(ctx, {
                        type: 'bar',
                        data: {
                            labels: response.labels,
                            datasets: [
                                {
                                    label: 'Lượt nghe',
                                    data: response.datasets[0].data,
                                    borderColor: 'rgb(75, 192, 192)',
                                    backgroundColor: 'rgba(75, 192, 192, 0.5)',
                                    order: 1
                                },
                                {
                                    label: 'Thời gian TB (giây)',
                                    data: response.datasets[1].data,
                                    type: 'line',
                                    borderColor: 'rgb(255, 99, 132)',
                                    backgroundColor: 'rgba(255, 99, 132, 0.1)',
                                    order: 2
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom' }
                            },
                            scales: {
                                y: { beginAtZero: true }
                            }
                        }
                    });
                }
            });
        }

        function updateStats() {
            $.get('@Url.Action("TopPois", "Analytics")', function(response) {
                if (response.success && response.data) {
                    const totalListens = response.data.reduce((sum, item) => sum + item.visitCount, 0);
                    const avgDuration = response.data.length > 0 
                        ? Math.round(response.data.reduce((sum, item) => sum + item.avgDuration, 0) / response.data.length)
                        : 0;

                    $('#totalListens').text(totalListens.toLocaleString('vi-VN'));
                    $('#activePois').text(response.data.length);
                    $('#avgDurationGlobal').text(avgDuration);

                    let topList = '<ol>';
                    response.data.slice(0, 5).forEach((item, idx) => {
                        topList += `<li><strong>${item.poiName}</strong><br/><small>${item.visitCount} lượt nghe</small></li>`;
                    });
                    topList += '</ol>';
                    $('#topPoiList').html(topList);
                }
            });
        }
    </script>

    <style>
        .progress { background-color: #e9ecef; }
        .progress-bar { background-color: #28a745; }
        .card { border: none; }
        .card-header { font-weight: 600; }
        .badge { padding: 0.5rem 0.75rem; }
    </style>
}
