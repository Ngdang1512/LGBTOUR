@model LGBTOUR.AdminWeb.Models.PoiViewModel
@{
    ViewData["Title"] = "Sửa Thông Tin Trạm";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="row">
    <div class="col-md-4">
        <div class="card card-warning shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold">Sửa Trạm: @Model.Name</h3>
            </div>
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                <div class="card-body">
                    <input type="hidden" asp-for="Id" />
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                    }

                    <div class="form-group">
                        <label asp-for="Name" class="font-weight-bold">Tên địa điểm</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label asp-for="Description" class="font-weight-bold">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Cập nhật Hình Ảnh (Tùy chọn)</label>
                        <div class="mb-2 text-center">
                            <img id="imgPreview" src="@(!string.IsNullOrEmpty(Model.Image) ? "https://localhost:7092" + Model.Image : "/images/no-image.png")"
                                 style="max-height: 150px; border-radius: 8px; border: 1px solid #ddd;" alt="Preview" />
                        </div>
                        <div class="custom-file">
                            <input type="file" name="uploadImage" class="custom-file-input" id="customFile" accept="image/*" onchange="previewImage(event)">
                            <label class="custom-file-label" for="customFile">Chọn ảnh mới đè lên ảnh cũ...</label>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Radius" class="font-weight-bold">Bán kính (m)</label>
                        <input asp-for="Radius" id="RadiusInput" class="form-control" type="number" required />
                    </div>
                    
                    <input type="hidden" asp-for="Lat" id="LatInput" />
                    <input type="hidden" asp-for="Lng" id="LngInput" />
                    <input type="hidden" asp-for="Priority" />
                    <input type="hidden" asp-for="IsStopStation" />
                </div>
                
                <div class="card-footer bg-white">
                    <button type="submit" class="btn btn-warning font-weight-bold"><i class="fas fa-save mr-1"></i> Cập Nhật</button>
                    <a asp-action="Index" class="btn btn-default float-right">Hủy</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-body p-1">
                <div id="map" style="height: 650px; width: 100%; border-radius: 4px;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // 1. Khởi tạo bản đồ lấy đúng Tọa độ hiện tại của Trạm
        var initialLat = @Model.Lat.ToString("G", System.Globalization.CultureInfo.InvariantCulture);
        var initialLng = @Model.Lng.ToString("G", System.Globalization.CultureInfo.InvariantCulture);
        var initialRadius = @Model.Radius;

        var map = L.map('map').setView([initialLat, initialLng], 17);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);

        var currentMarker = L.marker([initialLat, initialLng]).addTo(map);
        var currentCircle = L.circle([initialLat, initialLng], {
        color: 'red', fillColor: '#f03', fillOpacity: 0.2, radius: initialRadius
        }).addTo(map);

        // 2. Chức năng đổi tọa độ khi click lại trên map
        map.on('click', function(e) {
        var radius = parseInt(document.getElementById('RadiusInput').value) || 50;
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        map.removeLayer(currentMarker);
        map.removeLayer(currentCircle);

        currentMarker = L.marker([lat, lng]).addTo(map);
        currentCircle = L.circle([lat, lng], { color: 'red', fillColor: '#f03', fillOpacity: 0.2, radius: radius }).addTo(map);

        document.getElementById('LatInput').value = lat;
        document.getElementById('LngInput').value = lng;
        });

        document.getElementById('RadiusInput').addEventListener('input', function(e) {
        var radius = parseInt(e.target.value) || 0;
        currentCircle.setRadius(radius);
        });

        // 3. Logic: Preview ảnh lên màn hình
        function previewImage(event) {
        var reader = new FileReader();
        reader.onload = function(){
        var output = document.getElementById('imgPreview');
        output.src = reader.result;
        };
        reader.readAsDataURL(event.target.files[0]);
            
        // Đổi tên nhãn thành tên file
        event.target.nextElementSibling.innerText = event.target.files[0].name;
        }
    </script>
}