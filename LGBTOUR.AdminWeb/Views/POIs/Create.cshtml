@model LGBTOUR.AdminWeb.Entities.POI
@{
    ViewData["Title"] = "Thêm mới Địa điểm (POI)";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="container mt-4">
    <h2>Thêm mới Điểm đến (POI) - Quận 1</h2>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold">Tên địa điểm</label>
                    <input asp-for="Name" class="form-control" placeholder="VD: Nhà thờ Đức Bà" required />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Description" class="control-label fw-bold">Mô tả chi tiết</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Radius" class="control-label fw-bold">Bán kính kích hoạt Audio (mét)</label>
                    <input asp-for="Radius" id="RadiusInput" class="form-control" value="50" type="number" required />
                    <small class="text-muted">Khoảng cách du khách cần bước vào để app tự động phát âm thanh.</small>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Priority" class="control-label fw-bold">Độ ưu tiên</label>
                    <input asp-for="Priority" class="form-control" value="1" type="number" />
                </div>

                <input type="hidden" asp-for="Lat" id="LatInput" />
                <input type="hidden" asp-for="Lng" id="LngInput" />

                <div class="form-group mt-4">
                    <input type="submit" value="Lưu Địa Điểm" class="btn btn-primary w-100" />
                </div>
                <div class="mt-2 text-center">
                    <a asp-action="Index">Quay lại danh sách</a>
                </div>
            </form>
        </div>

        <div class="col-md-8">
            <div id="map" style="height: 600px; width: 100%; border-radius: 8px; border: 2px solid #007bff; box-shadow: 0 4px 8px rgba(0,0,0,0.1);"></div>
            <p class="text-danger mt-2 fw-bold">
                * HƯỚNG DẪN: Click chuột vào bản đồ để chọn tọa độ chính xác. Vòng tròn đỏ thể hiện bán kính kích hoạt thực tế.
            </p>
        </div>
    </div>
</div>

<script>
    // 1. Khởi tạo bản đồ, mặc định trỏ về trung tâm Quận 1 (Chợ Bến Thành)
    var map = L.map('map').setView([10.7725, 106.6980], 16);

    // 2. Load gạch bản đồ từ OpenStreetMap
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap - LGBTOUR'
    }).addTo(map);

    var currentMarker = null;
    var currentCircle = null;

    // 3. Hàm vẽ điểm và vòng tròn bán kính
    function drawMarkerAndCircle(lat, lng, radius) {
        if (currentMarker) {
            map.removeLayer(currentMarker);
            map.removeLayer(currentCircle);
        }

        currentMarker = L.marker([lat, lng]).addTo(map);

        currentCircle = L.circle([lat, lng], {
            color: 'red',
            fillColor: '#f03',
            fillOpacity: 0.2,
            radius: radius
        }).addTo(map);

        // Đổ dữ liệu tọa độ vào thẻ input ẩn để gửi về Server
        document.getElementById('LatInput').value = lat;
        document.getElementById('LngInput').value = lng;
    }

    // 4. Lắng nghe sự kiện click trên bản đồ
    map.on('click', function(e) {
        var radius = parseInt(document.getElementById('RadiusInput').value) || 50;
        drawMarkerAndCircle(e.latlng.lat, e.latlng.lng, radius);
    });

    // 5. Cập nhật vòng tròn trên map realtime nếu user tự gõ đổi số Radius
    document.getElementById('RadiusInput').addEventListener('input', function(e) {
        if (currentMarker) {
            var lat = currentMarker.getLatLng().lat;
            var lng = currentMarker.getLatLng().lng;
            var radius = parseInt(e.target.value) || 0;
            drawMarkerAndCircle(lat, lng, radius);
        }
    });
</script>