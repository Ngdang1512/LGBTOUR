@model IEnumerable<LGBTOUR.AdminWeb.Entities.Audio>
@{
    ViewData["Title"] = "Kho Âm Thanh";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h3 class="card-title font-weight-bold m-0 text-primary">
            <i class="fas fa-headphones-alt mr-2"></i> Kho File Thuyết Minh
        </h3>
        <a asp-action="Create" class="btn btn-primary btn-sm ml-auto">
            <i class="fas fa-plus"></i> Tải File Mới
        </a>
    </div>
    <div class="card-body p-0 table-responsive">
        <table class="table table-hover table-striped m-0">
            <thead class="bg-light">
                <tr>
                    <th>Địa Điểm (POI)</th>
                    <th class="text-center">Ngôn ngữ</th>
                    <th class="text-center">Thời lượng</th>
                    <th>Nghe thử</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle font-weight-bold text-primary">
                            @(item.POI != null ? item.POI.Name : "Chưa xác định")
                        </td>
                        <td class="align-middle text-center">
                            @if (item.LanguageCode == "vi")
                            {
                                <span class="badge badge-info px-2 py-1">Tiếng Việt</span>
                            }
                            else if (item.LanguageCode == "en")
                            {
                                <span class="badge badge-secondary px-2 py-1">Tiếng Anh</span>
                            }
                            else if (item.LanguageCode == "kr")
                            {
                                <span class="badge badge-success px-2 py-1">Tiếng Hàn</span>
                            }
                            else
                            {
                                <span class="badge badge-dark">@item.LanguageCode</span>
                            }
                        </td>
                        <td class="align-middle text-center">
                            @(item.Duration > 0 ? item.Duration + "s" : "-")
                        </td>
                        <td class="align-middle">
                            <!-- THẺ AUDIO CỦA HTML5 GIÚP PHÁT NHẠC TRỰC TIẾP -->
                            @if (!string.IsNullOrEmpty(item.AudioUrl))
                            {
                                <audio controls style="height: 35px; width: 250px;">
                                    <source src="@item.AudioUrl" type="audio/mpeg">
                                    Trình duyệt không hỗ trợ.
                                </audio>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Chưa có file</span>
                            }
                        </td>
                        <td class="align-middle text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>