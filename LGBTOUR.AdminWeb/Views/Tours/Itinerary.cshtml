@model List<LGBTOUR.AdminWeb.ViewModels.TourItineraryViewModel>
@{
    ViewData["Title"] = "Thiết lập Lộ trình";
    int tourId = ViewBag.TourId;
}

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">Thiết lập lộ trình cho: <strong>@ViewBag.TourName</strong></h3>
    </div>

    <form asp-action="UpdateItinerary" method="post">
        <input type="hidden" name="tourId" value="@tourId" />
        <div class="card-body p-0">
            <table class="table table-striped table-hover">
                <thead class="bg-light">
                    <tr>
                        <th style="width: 10%" class="text-center">Chọn</th>
                        <th>Tên Địa Điểm (POI)</th>
                        <th style="width: 20%">Thứ tự đi qua</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td class="text-center">
                                <!-- Lưu giữ ID ngầm để C# biết dòng nào -->
                                <input type="hidden" asp-for="@Model[i].POI_Id" />

                                <!-- Nút Checkbox -->
                                <input type="checkbox" asp-for="@Model[i].IsSelected" style="width: 20px; height: 20px; cursor: pointer;" />
                            </td>
                            <td class="align-middle fw-bold text-primary">
                                @Model[i].POIName
                            </td>
                            <td>
                                <!-- Ô nhập Thứ tự -->
                                <input type="number" asp-for="@Model[i].DisplayOrder" class="form-control" min="0" placeholder="0" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Lưu Lộ Trình</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
        </div>
    </form>
</div>