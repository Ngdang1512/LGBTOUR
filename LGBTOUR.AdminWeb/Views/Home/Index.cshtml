@{
    ViewData["Title"] = "Dashboard Quản Trị";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid mt-4">
    <h2 class="fw-bold mb-4">Tổng quan hoạt động Tour (Quận 1)</h2>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">📍 Bản đồ Nhiệt (Khu vực du khách tập trung nghe Audio)</h5>
                </div>
                <div class="card-body">
                    <div id="heatmap" style="height: 500px; width: 100%; border-radius: 5px;"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">📊 Top 5 Địa điểm Hot nhất</h5>
                </div>
                <div class="card-body">
                    <canvas id="topPoiChart" style="height: 450px; width: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    
    // --- 1. XỬ LÝ BẢN ĐỒ NHIỆT (HEATMAP) ---
    var map = L.map('heatmap').setView([10.7769, 106.7009], 15); // Focus trung tâm Q1

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap - LGBTOUR'
    }).addTo(map);

    // Nhận dữ liệu Tọa độ từ C# truyền xuống
    var rawHeatData = @Html.Raw(ViewBag.HeatMapData ?? "[]");

    // Chuyển format dữ liệu cho phù hợp với thư viện leaflet.heat
    var heatPoints = rawHeatData.map(function(item) {
        return [item.lat, item.lng, item.intensity];
    });

    // Vẽ lớp nhiệt lên bản đồ
    if(heatPoints.length > 0){
        L.heatLayer(heatPoints, { radius: 25, blur: 15, maxZoom: 17 }).addTo(map);
    } else {
        console.log("Chưa có dữ liệu người dùng nghe audio để vẽ Heatmap.");
    }

    // --- 2. XỬ LÝ BIỂU ĐỒ CHART.JS ---
    var rawChartData = @Html.Raw(ViewBag.TopPOIsData ?? "[]");

    var labels = rawChartData.map(function(item) { return item.Name; });
    var counts = rawChartData.map(function(item) { return item.Count; });

    var ctx = document.getElementById('topPoiChart').getContext('2d');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: labels,
            datasets: [{
                label: 'Số lượt nghe',
                data: counts,
                backgroundColor: 'rgba(75, 192, 192, 0.6)',
                borderColor: 'rgba(75, 192, 192, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: { y: { beginAtZero: true } }
        }
    });
</script>