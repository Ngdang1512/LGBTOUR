@{
    ViewData["Title"] = "Dashboard Quản Trị";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet.heat/dist/leaflet-heat.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid">
    <h3 class="fw-bold mb-4 text-dark"><i class="fas fa-tachometer-alt mr-2"></i> Tổng Quan Hoạt Động (Quận 1)</h3>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title m-0 font-weight-bold"><i class="fas fa-fire mr-1"></i> Bản đồ Nhiệt (Khu vực du khách tập trung nghe)</h5>
                </div>
                <div class="card-body p-1">
                    <div id="heatmap" style="height: 500px; width: 100%; border-radius: 4px;"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title m-0 font-weight-bold"><i class="fas fa-chart-bar mr-1"></i> Top 5 Trạm Hot Nhất</h5>
                </div>
                <div class="card-body">
                    <canvas id="topPoiChart" style="height: 450px; width: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // --- 1. XỬ LÝ BẢN ĐỒ NHIỆT (HEATMAP) ---
        var map = L.map('heatmap').setView([10.7769, 106.7009], 15);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© OpenStreetMap - LGBTOUR'
        }).addTo(map);

        // Nhận dữ liệu Tọa độ từ C#
        var rawHeatData = @Html.Raw(ViewBag.HeatMapData ?? "[]");

        var heatPoints = rawHeatData.map(function(item) {
        return [item.lat, item.lng, item.intensity];
        });

        if(heatPoints.length > 0){
        L.heatLayer(heatPoints, { radius: 30, blur: 20, maxZoom: 17 }).addTo(map);
        }

        // --- 2. XỬ LÝ BIỂU ĐỒ CHART.JS ---
        var rawChartData = @Html.Raw(ViewBag.TopPOIsData ?? "[]");

        var labels = rawChartData.map(function(item) { return item.PoiName; });
        var counts = rawChartData.map(function(item) { return item.TotalListens; });

        var ctx = document.getElementById('topPoiChart').getContext('2d');
        new Chart(ctx, {
        type: 'bar',
        data: {
        labels: labels,
        datasets: [{
        label: 'Số lượt nghe',
        data: counts,
        backgroundColor: 'rgba(40, 167, 69, 0.7)',
        borderColor: 'rgba(40, 167, 69, 1)',
        borderWidth: 1,
        borderRadius: 4
        }]
        },
        options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
        y: { beginAtZero: true, ticks: { stepSize: 1 } }
        }
        }
        });
    </script>
}