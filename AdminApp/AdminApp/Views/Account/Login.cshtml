@{
    ViewData["Title"] = "Đăng nhập quản trị";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold mb-1">AdminApp</h2>
                    <p class="text-muted mb-0">Đăng nhập hệ thống quản trị</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Tài khoản</label>
                        <input name="username" class="form-control form-control-lg" autocomplete="username" placeholder="admin@email.com hoặc username" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <input name="password" type="password" class="form-control form-control-lg" autocomplete="current-password" placeholder="Nhập mật khẩu" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100">Đăng nhập</button>
                </form>
            </div>
        </div>
    </div>
</div>
