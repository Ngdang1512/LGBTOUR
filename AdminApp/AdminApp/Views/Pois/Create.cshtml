@model AdminApp.Models.Poi

@{
    ViewData["Title"] = "Thêm POI";
}

<div class="card shadow-sm border-0">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Lat" class="form-label"></label>
                    <input asp-for="Lat" class="form-control" />
                    <span asp-validation-for="Lat" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Lng" class="form-label"></label>
                    <input asp-for="Lng" class="form-control" />
                    <span asp-validation-for="Lng" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Radius" class="form-label"></label>
                    <input asp-for="Radius" class="form-control" />
                    <span asp-validation-for="Radius" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Image" class="form-label"></label>
                    <input asp-for="Image" class="form-control" />
                    <span asp-validation-for="Image" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AudioPath" class="form-label"></label>
                    <input asp-for="AudioPath" class="form-control" />
                    <span asp-validation-for="AudioPath" class="text-danger"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Lưu</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
