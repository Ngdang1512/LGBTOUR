@{
    ViewData["Title"] = "Dashboard";
}

<div class="py-4">
    <h1 class="fw-bold">Dashboard quản trị</h1>
    <p class="text-muted mb-4">Quản lý địa điểm, tuyến xe buýt và dữ liệu thuyết minh.</p>

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">Địa điểm</h5>
                    <p class="card-text text-muted">Thêm, sửa, xóa POI và hình ảnh.</p>
                    <a class="btn btn-primary" asp-controller="Pois" asp-action="Index">Mở danh sách POI</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">Tuyến xe</h5>
                    <p class="card-text text-muted">Quản lý tuyến và điểm dừng.</p>
                    <a class="btn btn-outline-primary" href="#">Sắp tới</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <h5 class="card-title">Thuyết minh</h5>
                    <p class="card-text text-muted">Quản lý nội dung audio/narration.</p>
                    <a class="btn btn-outline-primary" href="#">Sắp tới</a>
                </div>
            </div>
        </div>
    </div>
</div>
